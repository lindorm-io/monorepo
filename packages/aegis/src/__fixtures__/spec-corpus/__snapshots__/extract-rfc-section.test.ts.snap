exports[`extractRfcSection > should end a section at a word heading 1`] = `
"5.  Terminated

   This section runs to the word heading below it rather than to the
   end of the document, which is how a numbered body ends.  It carries
   enough text to clear the floor."
`;

exports[`extractRfcSection > should extract a section with its subsections 1`] = `
{
  "body": "2.  Claims

   The claims section names the "mini" claim and MUST be extracted
   together with its subsections, which is the scope a section anchor
   implies.

2.1.  The "mini" Claim

   The "mini" claim carries a value.  It sits inside section 2 and
   travels with it, so a citation of the parent covers the child.  Use
   of this claim is OPTIONAL.",
  "heading": "2.  Claims",
  "span": {
    "end": 41,
    "start": 29,
    "unit": "line",
  },
}
`;
