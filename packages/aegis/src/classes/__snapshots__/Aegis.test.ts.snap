exports[`Aegis > the encoding of the token a domain refusal refused > confirmation_binds_no_key on a jose token whose confirmation has an empty thumbprint names the member in the domain vocabulary in data and the wire's in debug 1`] = `
{
  "code": "confirmation_binds_no_key",
  "data": {
    "member": "confirmation.thumbprint",
  },
  "debug": {
    "confirmation": {
      "thumbprint": "",
    },
    "format": "jwt",
    "member": "cnf.jkt",
  },
  "message": "Invalid token: the confirmation binds no key",
  "name": "AegisDomainError",
}
`;

exports[`Aegis > the encoding of the token a domain refusal refused > confirmation_binds_no_key on a jose token whose confirmation has no member names the member in the domain vocabulary in data and the wire's in debug 1`] = `
