exports[`Aegis > the encoding of the token a domain refusal refused > claims_invalid keeps the cwt encoding out of data and reports it in debug 1`] = `
{
  "code": "claims_invalid",
  "data": {
    "invalid": [
      "subject",
    ],
  },
  "debug": {
    "format": "cwt",
    "invalid": [
      {
        "key": "sub",
        "value": "user-1",
      },
    ],
  },
  "message": "Invalid token",
  "name": "AegisDomainError",
}
`;

