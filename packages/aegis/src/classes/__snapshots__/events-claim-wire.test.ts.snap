}
`;

exports[`an event payload that is not a JSON object > mint refuses the events map an undefined payload leaves empty, as an empty map 1`] = `
{
  "cose": {
    "code": "claim_empty_value",
    "data": {
      "claim": "events",
      "whenEmpty": "refuse",
    },
    "debug": {},
    "message": "Claim "events" carries no value",
    "name": "AegisDomainError",
  },
  "jose": {
    "code": "claim_empty_value",
    "data": {
      "claim": "events",
      "whenEmpty": "refuse",
    },
    "debug": {},
    "message": "Claim "events" carries no value",
    "name": "AegisDomainError",
  },
}
`;

