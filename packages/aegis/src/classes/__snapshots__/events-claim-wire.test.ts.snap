exports[`an event payload that is not a JSON object > Aegis.toDomain refuses an event whose payload is a boolean, naming the event 1`] = `
{
  "code": "claim_structure_invalid",
  "data": {
    "claim": "events",
    "invalid": [
      {
        "key": "events.urn:lindorm:event:test",
        "message": "Member "urn:lindorm:event:test" must be an object",
      },
    ],
  },
  "debug": {
    "claim": "events",
    "invalid": [
      {
        "key": "events.urn:lindorm:event:test",
        "message": "Member "urn:lindorm:event:test" must be an object",
      },
    ],
  },
  "message": "Invalid claim structure",
  "name": "AegisDomainError",
}
`;

