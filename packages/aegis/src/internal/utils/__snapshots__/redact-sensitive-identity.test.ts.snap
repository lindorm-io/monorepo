// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`redactSensitiveIdentity > filters the FLAT camelCase domain identity numbers too 1`] = `
{
  "nationalIdentityNumber": "[Filtered]",
  "nationalIdentityNumberVerified": true,
  "socialSecurityNumber": "[Filtered]",
  "socialSecurityNumberVerified": false,
  "subject": "sub-1",
}
`;

exports[`redactSensitiveIdentity > filters the FLAT wire identity numbers and keeps the verified flags 1`] = `
{
  "national_identity_number": "[Filtered]",
  "national_identity_number_verified": true,
  "social_security_number": "[Filtered]",
  "social_security_number_verified": false,
  "sub": "sub-1",
}
`;

exports[`redactSensitiveIdentity > tolerates a null identity number 1`] = `
{
  "nationalIdentityNumber": null,
  "subject": "sub-1",
}
`;

exports[`redactVerifyOptions > sanitises a dpop proof to its header and payload 1`] = `
{
  "audience": "aud",
  "dpopProof": "header-segment.payload-segment",
}
`;
