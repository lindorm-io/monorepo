// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`resolveSettings > should reject an unknown key, naming it 1`] = `
{
  "code": "unknown_setting",
  "data": {
    "key": "featurs",
    "known": [
      "features",
      "steps",
      "tags",
    ],
  },
  "details": "GherkinSettings carries \`features\`, \`steps\` and \`tags\` only. An accepted-but-unimplemented key would be a silent no-op, so an unknown one fails at config time instead. Remove the key, or fix its spelling.",
  "message": "Unknown gherkin setting "featurs"",
}
`;

exports[`resolveSettings > tagFilter > should throw invalid_tag_expression at construction for a malformed expression 1`] = `
{
  "code": "invalid_tag_expression",
  "data": {
    "tags": "@smoke and",
  },
  "details": "The \`tags\` setting selects scenarios at transform time with Cucumber's tag-expression language — \`and\` / \`or\` / \`not\` with parentheses over @-prefixed tags (NOT vitest's --tagsFilter syntax). Fix the expression.",
  "message": "Invalid tag expression "@smoke and" in gherkin setting "tags"",
}
`;
