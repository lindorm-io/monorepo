// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`createScenarioContainer > cycles > should throw cyclic_context naming the full cycle path 1`] = `
{
  "code": "cyclic_context",
  "data": {
    "cycle": [
      "AContext",
      "BContext",
      "AContext",
    ],
  },
  "details": "Resolving the token re-entered its own resolution — the @Context classes inject each other in a loop, which no construction order can satisfy. Break the loop by removing one of the @Inject fields, or move the shared state into a third context both inject.",
  "message": "Cyclic context injection: AContext -> BContext -> AContext",
  "title": "Cyclic Context Injection",
  "type": "urn:lindorm:gherkin:error:cyclic_context",
}
`;

exports[`createScenarioContainer > resolution > should refuse to resolve after dispose — a late context would never be disposed 1`] = `
{
  "code": "container_disposed",
  "data": {
    "token": "LateContext",
  },
  "details": "The scenario container was already disposed; resolving would construct a context whose dispose() never runs. Nothing may touch the container after the scenario's teardown.",
  "message": "Cannot resolve LateContext after dispose()",
  "title": "Container Disposed",
  "type": "urn:lindorm:gherkin:error:container_disposed",
}
`;

exports[`createScenarioContainer > unknown tokens > should name the token and the demanding field when resolved via assignInjects 1`] = `
{
  "code": "unknown_context_token",
  "data": {
    "className": "BindingHost",
    "fieldName": "missing",
    "token": "UnregisteredContext",
  },
  "details": "The token is neither a registered @Context class nor ScenarioInfo — the usual authoring mistake is a missing @Context() decorator on the token class. Add @Context() to it, or inject a registered context.",
  "message": "Unknown context token UnregisteredContext demanded by BindingHost.missing",
  "title": "Unknown Context Token",
  "type": "urn:lindorm:gherkin:error:unknown_context_token",
}
`;
