exports[`scaffold > writeIrisSamples > snapshot: kafka publisher + subscriber > publisher 1`] = `
"import { kafka } from "../source.js";
import { SampleMessage } from "../messages/SampleMessage.js";

const publisher = kafka.publisher(SampleMessage);

export const publishSample = async (
  payload: Partial<SampleMessage> = {},
): Promise<void> => {
  await publisher.publish(publisher.create(payload));
};
"
`;

exports[`scaffold > writeIrisSamples > snapshot: kafka publisher + subscriber > subscriber 1`] = `
"import { logger } from "../../logger/index.js";
import { kafka } from "../source.js";
import { SampleMessage } from "../messages/SampleMessage.js";

const bus = kafka.messageBus(SampleMessage);

export const subscribeSample = async (): Promise<void> => {
  await bus.subscribe({
    topic: "SampleMessage",
    queue: "sample-queue",
    callback: async (msg) => {
      logger.info("Received sample message", { message: msg });
    },
  });
};
"
`;

