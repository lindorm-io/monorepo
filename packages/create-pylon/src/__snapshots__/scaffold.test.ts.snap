exports[`scaffold > scaffold orchestration > all-on: postgres + redis + rabbit + sessions + auth + rateLimit + workers > config.ts 1`] = `
"import { configuration } from "@lindorm/config";
import { z } from "zod";

// Each leaf is overridable from the environment. The env-var name is
// the schema path with each segment converted to CONSTANT_CASE and
// joined with "__":
//
//   pylon.kek           → PYLON__KEK
//   server.port         → SERVER__PORT
//   issuer              → ISSUER (single segment, no separator)
//   nodeEnv             → NODE_ENV (single segment, no separator)
//
// See config/default.yml for non-secret defaults you can edit.
export const config = configuration(
  {
    nodeEnv: z
      .enum(["production", "staging", "development", "test", "unknown"])
      .default("development"),
    // This service's own issuer URL. Becomes the Amphora \`domain\`, from which
    // every minted Kryptos key derives its issuer + jwks_uri. Override per-env
    // (ISSUER) — never ship localhost to production.
    issuer: z.string(),
    pylon: z.object({ kek: z.string() }),
    server: z.object({ port: z.number() }),
    logger: z
      .object({
        level: z
          .enum(["error", "warn", "info", "verbose", "debug", "silly"])
          .default("info"),
        readable: z.boolean().default(false),
      })
      .prefault({}),
    postgres: z.object({
      url: z.string(),
      synchronize: z.boolean().default(false),
      migrations: z.boolean().default(false),
    }),
    redis: z.object({
      url: z.string(),
    }),
    rabbit: z.object({
      url: z.string(),
    }),
    auth: z.object({
      clientId: z.string(),
      clientSecret: z.string(),
      issuer: z.string(),
    }),
  },
  { scope: import.meta.url },
);
"
`;

exports[`scaffold > scaffold orchestration > all-on: postgres + redis + rabbit + sessions + auth + rateLimit + workers > pylon.ts 1`] = `
"import { Pylon } from "@lindorm/pylon";
import { join } from "path";
import { logger } from "../logger/index.js";
import { amphora } from "./amphora.js";
import { config } from "./config.js";
import { postgres } from "../proteus/db/source.js";
import { redis } from "../proteus/kv/source.js";
import { rabbit } from "../iris/source.js";

export const pylon = new Pylon({
  logger,
  amphora,
  name: config.npm.package.name,
  version: config.npm.package.version,
  environment: config.nodeEnv,
  port: config.server.port,
  routes: join(import.meta.dirname, "..", "routes"),
  socket: {
    enabled: true,
    listeners: join(import.meta.dirname, "..", "listeners"),
  },
  rooms: { presence: true },
  db: postgres,
  kryptos: { enabled: true },
  keys: {
    cookieSignature: { predicate: { purpose: "cookie", publish: false } },
    cookieVerification: { predicate: { purpose: "cookie", publish: false } },
    cookieEncryption: { predicate: { purpose: "cookie", publish: false } },
    sessionEncryption: { predicate: { purpose: "session", publish: false } },
  },
  kv: redis,
  bus: rabbit,
  queue: { enabled: true },
  webhook: { enabled: true },
  audit: {
    enabled: true,
    // sanitise: (body) => body,
    // skip: (ctx) => false,
    // entities: [],
  },
  session: {
    enabled: true,
    kv: redis,
    name: "sid",
    encrypted: true,
    httpOnly: true,
    sameSite: "lax",
    secure: false, // TODO: flip to true in production (behind HTTPS)
    expiry: "7d",
  },
  auth: {
    clientId: config.auth.clientId,
    clientSecret: config.auth.clientSecret,
    issuer: config.auth.issuer,
    router: {
      pathPrefix: "/auth",
      authorize: {
        scope: ["openid", "profile", "email"],
        responseType: "code",
      },
    },
  },
  rateLimit: {
    enabled: true,
    kv: redis,
    strategy: "fixed",
    window: "1m",
    max: 60,
    // TODO: tune strategy/window/max for your traffic
  },
  workers: join(import.meta.dirname, "..", "workers"),
  setup: async () => {
    await postgres.connect();
    await redis.connect();
    await rabbit.connect();
  },
  teardown: async () => {
    // pylon handles proteus/iris disconnect automatically
  },
});
"
`;

