// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`redactData > should filter an unparseable body naming a sensitive key 1`] = `"[Filtered]"`;

exports[`redactData > should filter camel cased secrets 1`] = `
{
  "clientId": "client_01HZ",
  "clientSecret": "[Filtered]",
}
`;

exports[`redactData > should filter password and secret keys 1`] = `
{
  "password": "[Filtered]",
  "secret": "[Filtered]",
  "username": "user",
}
`;

exports[`redactData > should filter secrets entirely 1`] = `
{
  "client_id": "client_01HZ",
  "client_secret": "[Filtered]",
  "grant_type": "client_credentials",
}
`;

exports[`redactData > should leave a plain string body untouched 1`] = `"Not Found"`;

exports[`redactData > should not deep walk nested objects 1`] = `
{
  "items": [
    1,
    2,
    3,
  ],
  "user": {
    "password": "s3cr3t-p4ssw0rd",
  },
}
`;

exports[`redactData > should redact a serialised json body 1`] = `"{"client_id":"client_01HZ","client_secret":"[Filtered]"}"`;

