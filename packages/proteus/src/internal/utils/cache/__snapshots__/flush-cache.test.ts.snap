`;

exports[`flushCache > unregistered entity > should throw entity_not_registered rather than silently no-op 1`] = `
{
  "code": "entity_not_registered",
  "data": {
    "target": "FlushUnregistered",
  },
  "details": "Entity "FlushUnregistered" is not registered with this source; register it via the source's entities option or addEntities().",
  "message": "Cannot flush the cache for entity "FlushUnregistered" — it is not registered with this source",
  "title": "Entity Not Registered",
  "type": "urn:lindorm:proteus:error:entity_not_registered",
}
`;
