// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`flushCache > adapter failure > should throw cache_flush_failed instead of swallowing like implicit invalidation 1`] = `
{
  "code": "cache_flush_failed",
  "data": {
    "prefixes": [
      "cache:FlushUser:",
    ],
  },
  "details": "The cache adapter rejected the flush; cached queries may still serve stale data.",
  "errors": [
    "Error: redis is down",
  ],
  "message": "Failed to flush the query cache",
  "title": "Cache Flush Failed",
  "type": "urn:lindorm:proteus:error:cache_flush_failed",
}
`;

