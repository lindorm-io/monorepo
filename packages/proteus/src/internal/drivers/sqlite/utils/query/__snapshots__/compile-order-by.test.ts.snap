// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`compileOrderBy > should append multiple raw fragments in insertion order 1`] = `"ORDER BY n DESC, name ASC"`;

exports[`compileOrderBy > should append raw fragment params positionally after existing params 1`] = `"ORDER BY "t0"."name" ASC NULLS LAST, score > ? DESC"`;

exports[`compileOrderBy > should compile single field ASC with NULLS LAST 1`] = `"ORDER BY "t0"."name" ASC NULLS LAST"`;

exports[`compileOrderBy > should compile single field DESC with NULLS FIRST 1`] = `"ORDER BY "t0"."age" DESC NULLS FIRST"`;

exports[`compileOrderBy > should emit ORDER BY for a raw-only fragment with no field terms 1`] = `"ORDER BY n DESC"`;

exports[`compileOrderBy > should emit field terms (with NULLS clause) first, then raw terms 1`] = `"ORDER BY "t0"."name" ASC NULLS LAST, n DESC"`;
